{
  "buildCommand": "cd kabadconnect-web && npm install && npm run build",
  "outputDirectory": "kabadconnect-web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
