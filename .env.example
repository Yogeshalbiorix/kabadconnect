# ===================================================
# KabadCollect Environment Configuration for Vercel
# ===================================================

# 1. MongoDB Atlas Connection URI
# Sign up free at: https://www.mongodb.com/cloud/atlas
# Create a Free M0 Cluster -> Database Access (User/Password) -> Network Access (Allow 0.0.0.0/0)
MONGODB_URI=mongodb+srv://yogeshalbiorix_db_user:<db_password>@cluster0.xzdc97o.mongodb.net/?appName=Cluster0

# 2. Mapbox Public Access Token (Optional, for Live Hyperlocal Map)
# Free token at: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=<mapbox_public_token>
VITE_MAP_API_KEY=<mapbox_public_token>

# 3. Email OTP Dispatch (Gmail or SMTP) - Optional
# If omitted, test mode will auto-display the OTP code instantly on screen
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Or generic SMTP:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password

# 4. Razorpay Standard Checkout Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id